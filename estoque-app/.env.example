# Porta interna (o nginx encaminha para ela)
PORT=3100
# URL publica do sistema
BASE_URL=https://zus.lucasprogramador.com.br
# Senha que as meninas usam para entrar no sistema
APP_PASSWORD=troque-esta-senha
# Segredo aleatorio para assinar o login (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-aleatorio

# Nuvemshop: dados do app criado no Portal de Parceiros
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Preenchidos sozinhos ao acessar /instalar (pode deixar vazio)
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=

# OpenAI: gera nome e descricao a partir da foto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
